<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".controller.AnimeFormActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/formTitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Novo anime"
            android:textColor="#3F51B5"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/titleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Título" />

        <EditText
            android:id="@+id/titleEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex.: Aurora"
            android:inputType="textCapSentences" />

        <TextView
            android:id="@+id/episodesTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Episódios disponíveis" />

        <EditText
            android:id="@+id/episodesEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex.: 12"
            android:inputType="number" />

        <TextView
            android:id="@+id/starsTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recomendação" />

        <Spinner
            android:id="@+id/starsSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:id="@+id/opinionTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Opinião" />

        <EditText
            android:id="@+id/opinionEditText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="top"
            android:hint="O que você achou?"
            android:inputType="textMultiLine|textCapSentences" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/saveButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:onClick="save"
                android:text="Salvar" />

            <Button
                android:id="@+id/cancelButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Cancelar" />

            <Button
                android:id="@+id/deleteButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:onClick="delete"
                android:text="Excluir" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
